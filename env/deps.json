    "go",
    "graphviz",
    "grpcurl",
    "htop",
    "jq",
    "kubectx",
    "kubernetes-cli",
    "lftp",
    "libpq",
    "poppler",
    "postgresql@14",
    "postgresql@15",
    "python@3.13",
    "ripgrep",
    "ruff",
    "semgrep",
    "shellcheck",
    "sqlite",
    "sqruff",
    "tmux",
    "uv",
    "watch",
    "zsh",
    "zsh-autosuggestions",
    "zsh-syntax-highlighting"
  ],
  "brewcask": [
    "docker-desktop",
    "gcloud-cli"
  ],
  "go": [
    "github.com/bokwoon95/wgo",
    "github.com/go-delve/delve/cmd/dlv",
    "github.com/golangci/golines",
    "github.com/oligot/go-mod-upgrade",
    "golang.org/x/tools/cmd/goimports",
    "golang.org/x/tools/gopls",
    "gotest.tools/gotestsum",
    "honnef.co/go/tools/cmd/staticcheck"
  ],
  "gcloud": [
    "beta",
    "kubectl",
    "bq",
    "cloud-run-proxy",
    "gsutil",
    "core",
    "gcloud-crc32c",
    "minikube",
    "skaffold",
    "gke-gcloud-auth-plugin"
  ],
  "nvm": [
    "lts/*"
  ],
  "npm": [
    "npm-check-updates"
  ],
  "pip": [
    "black",
    "duckdb",
    "filelock",
    "google-cloud-bigquery",
    "grpcio",
    "grpcio-tools",
    "httpx",
    "isort",
    "jupyterlab",
    "jupyterlab-code-formatter",
    "numpy",
    "pandas[performance]",
    "polars[numpy,fsspec,pandas,iceberg]",
    "pre-commit",
    "protovalidate",
    "psycopg2-binary",
    "pyarrow",
    "pytest",
    "pytest-xdist",
    "pytz",
    "requests",
    "urllib3"
  ],
  "pip_private": [],
  "jupyter": [
    "jupyterlab_code_formatter"
  ],
  "custom": [
    {
      "name": "nvm",
      "command": "curl -o- https://raw.githubusercontent.com/nvm-sh/nvm/master/install.sh | bash"
    },
    {
      "name": "golangci-lint",
      "command": "curl -sSfL https://raw.githubusercontent.com/golangci/golangci-lint/main/install.sh | sh -s -- -b \"$(go env GOPATH)\"/bin latest"
    },
    {
      "name": "rust",
      "command": "curl --proto '=https' --tlsv1.2 -sSf https://sh.rustup.rs | sh -s -- -y"
    },
    {
      "name": "zvm",
      "command": "curl https://raw.githubusercontent.com/tristanisham/zvm/master/install.sh | bash && chmod +x \"${ZVM_INSTALL:-$HOME/.zvm/self}/zvm\""
    },
    {
      "name": "zig",
      "command": "zvm i master"
    },
    {
      "name": "sdkman",
      "command": "[ -d \"$HOME/.sdkman\" ] || curl -s https://get.sdkman.io | bash"
    },
    {
      "name": "oh-my-zsh",
      "command": "[ -d \"$HOME/.oh-my-zsh\" ] || sh -c \"$(curl -fsSL https://raw.githubusercontent.com/ohmyzsh/ohmyzsh/master/tools/install.sh)\" \"\" --unattended --keep-zshrc"
    },
    {
      "name": "powerlevel10k",
      "command": "[ -d \"$HOME/.oh-my-zsh/custom/themes/powerlevel10k\" ] || git clone --depth=1 https://github.com/romkatv/powerlevel10k.git \"$HOME/.oh-my-zsh/custom/themes/powerlevel10k\""
    },
    {
      "name": "zsh-autosuggestions",
      "command": "[ -d \"$HOME/.oh-my-zsh/custom/plugins/zsh-autosuggestions\" ] || git clone --depth=1 https://github.com/zsh-users/zsh-autosuggestions \"$HOME/.oh-my-zsh/custom/plugins/zsh-autosuggestions\""
    },
    {
      "name": "zsh-syntax-highlighting",
      "command": "[ -d \"$HOME/.oh-my-zsh/custom/plugins/zsh-syntax-highlighting\" ] || git clone --depth=1 https://github.com/zsh-users/zsh-syntax-highlighting.git \"$HOME/.oh-my-zsh/custom/plugins/zsh-syntax-highlighting\""
    }
  ],
  "sdk": [
    "java 17.0.14-tem",
    "scala 2.13.16"
  ]
}
